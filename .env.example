# Required — use the NEW MCWV Games application token, never MCWV BOT's token.
DISCORD_TOKEN=
GUILD_ID=1501608673250640055
OWNER_ID=
DATABASE_URL=

# Render injects PORT; 10000 is the local default.
PORT=10000
DB_SSLMODE=require
# Optional DB timeout overrides; defaults shown.
DB_STATEMENT_TIMEOUT_MS=1800
DB_LOCK_TIMEOUT_MS=900
CLAN_NAME=MCWV

# Optional SELECT-only connection for live War Bingo and MCWV history trivia.
# Leave blank for maximum isolation; those features use safe fallbacks.
MCWV_READONLY_DATABASE_URL=
